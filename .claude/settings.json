{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/workflow/wf.py\" hook pre-tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/workflow/wf.py\" hook stop"
          }
        ]
      }
    ]
  }
}
